<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>grid_drive</name>
  <version>0.0.0</version>
  <description>비용 지도 위 최단 경로 (Dijkstra) + 원호 후보로 따라가는 주행 계획 (색 방식 / 세그멘테이션 관측)</description>
  <maintainer email="nano2@todo.todo">nano2</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>libopencv-dev</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>interfaces</depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>vision_bringup</exec_depend>
  <exec_depend>stm</exec_depend>
  <exec_depend>parking</exec_depend>
  <exec_depend>task_planner</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
