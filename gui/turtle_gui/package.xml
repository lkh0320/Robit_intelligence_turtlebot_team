<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>turtle_gui</name>
  <version>0.1.0</version>
  <description>Qt GUI for the Robit TurtleBot team robot</description>
  <maintainer email="lkh060320@gmail.com">Robit TurtleBot Team</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- C++ GUI 본체(qnode.cpp)가 쓰는 ROS 2 패키지 -->
  <depend>rclcpp</depend>
  <depend>rcl_interfaces</depend>      <!-- 파라미터 목록/설정 결과 타입 -->
  <depend>sensor_msgs</depend>         <!-- CompressedImage (카메라 영상) -->
  <depend>geometry_msgs</depend>       <!-- Twist (수동 조종 명령) -->
  <depend>std_srvs</depend>            <!-- SetBool (Start/Stop, E-STOP) -->
  <depend>turtle_interfaces</depend>   <!-- 팀 커스텀 msg/srv -->
  <depend>qtbase5-dev</depend>         <!-- Qt5 Widgets (rosdep 으로 설치 가능) -->

  <!-- scripts/fake_robot.py (로봇 없이 테스트용 가짜 노드)가 실행될 때 필요 -->
  <exec_depend>rclpy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
